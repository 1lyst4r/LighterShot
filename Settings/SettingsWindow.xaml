<Window x:Class="Snappo.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snappo Settings"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown">

    <DockPanel Margin="12">

        <!-- Save / Cancel / Reset stay visible no matter which category is open -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Reset to Defaults" Padding="10,5" Click="ResetToDefaultsButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Width="80" Padding="0,5" Click="SaveButton_Click" />
                <Button Content="Cancel" IsCancel="True" Width="80" Padding="0,5" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl>

            <!-- ============ General ============ -->
            <TabItem Header="General">
                <StackPanel Margin="16">
                    <CheckBox x:Name="NotificationCheckBox"
                              Content="Show notifications about copying and saving" />

                    <CheckBox x:Name="KeepSelectionCheckBox" Margin="0,10,0,0"
                              Content="Keep the selected area position"
                              ToolTip="The next screenshot starts with the same area already selected." />

                    <CheckBox x:Name="CaptureCursorCheckBox" Margin="0,10,0,0"
                              Content="Capture a cursor on a screenshot" />

                    <CheckBox x:Name="StartupCheckBox" Margin="0,10,0,0"
                              Content="Start Snappo when Windows starts" />

                    <TextBlock Text="Delay before capturing" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <ComboBox x:Name="CaptureDelayComboBox" Margin="0,6,0,0" Padding="8,5">
                        <ComboBoxItem Content="No delay" />
                        <ComboBoxItem Content="3 seconds" />
                        <ComboBoxItem Content="5 seconds" />
                        <ComboBoxItem Content="10 seconds" />
                    </ComboBox>

                    <TextBlock Text="Save screenshots to" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Padding="12,5"
                                Click="BrowseButton_Click" />
                        <TextBox x:Name="SaveFolderTextBox" VerticalContentAlignment="Center" Padding="4" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- ============ Hotkeys ============ -->
            <TabItem Header="Hotkeys">
                <StackPanel Margin="16">
                    <TextBlock Text="General hotkey" FontWeight="SemiBold" />
                    <TextBlock Text="Starts a screenshot from anywhere, even inside a game." Foreground="Gray" Margin="0,2,0,0" />

                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="ResetHotkeyButton" DockPanel.Dock="Right" Content="Reset"
                                Margin="8,0,0,0" Padding="12,5" Click="ResetHotkeyButton_Click" />
                        <Button x:Name="HotkeyButton" HorizontalContentAlignment="Left" Padding="10,6"
                                Click="HotkeyButton_Click"
                                PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                PreviewKeyUp="HotkeyButton_PreviewKeyUp"
                                LostKeyboardFocus="HotkeyButton_LostKeyboardFocus" />
                    </DockPanel>

                    <TextBlock x:Name="HotkeyHintText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray" />
                </StackPanel>
            </TabItem>

            <!-- ============ Format ============ -->
            <TabItem Header="Format">
                <StackPanel Margin="16">
                    <TextBlock Text="Save using the format" FontWeight="SemiBold" />
                    <ComboBox x:Name="FormatComboBox" Margin="0,6,0,0" Padding="8,5">
                        <ComboBoxItem Content="PNG" />
                        <ComboBoxItem Content="JPEG" />
                    </ComboBox>

                    <TextBlock x:Name="QualityTitleText" Text="JPEG quality" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="QualityValueText" DockPanel.Dock="Right" Width="36"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" LargeChange="10" SmallChange="1" />
                    </DockPanel>
                    <TextBlock x:Name="QualityHintText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray" />
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
